{
  "name": "genpw",
  "version": "2.0.12",
  "description": "Generate a random Diceware passphrase.",
  "keywords": [
    "password",
    "passphrase",
    "diceware",
    "generator",
    "random"
  ],
  "homepage": "https://genpw.com",
  "bugs": {
    "url": "https://github.com/genpw/genpw/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genpw/genpw.git"
  },
  "license": "MIT",
  "author": "Matthew <matthew@mi11er.net> (https://mi11er.net)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "bin": {
    "genpw": "./bin/genpw.js"
  },
  "files": [
    "bin",
    "src",
    "types",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build:types": "tsc -p tsconfig.json",
    "clean": "rimraf coverage types release",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check .",
    "prepack": "npm run build:types",
    "prepare": "husky",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-exclude=test/**",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      [
        "@semantic-release/npm",
        {
          "tarballDir": "release"
        }
      ],
      [
        "@semantic-release/git",
        {
          "assets": [
            "CHANGELOG.md",
            "package.json"
          ]
        }
      ],
      [
        "@semantic-release/github",
        {
          "assets": [
            {
              "path": "release/*.tgz",
              "label": "Package tarball"
            }
          ]
        }
      ]
    ]
  },
  "dependencies": {},
  "devDependencies": {
    "@mi11er/eslint-config": "3.0.5",
    "@types/node": "26.6.11",
    "eslint": "10.15.0",
    "eslint-plugin-import-x": "4.18.1",
    "eslint-plugin-n": "18.6.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-optimize-regex": "1.2.1",
    "eslint-plugin-security": "4.2.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "rimraf": "6.1.4",
    "sort-package-json": "4.1.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=26"
  }
}
